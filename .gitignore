*cookies*.json
*.token.json
*credentials*.json
*secret*.json
*.key
*.pem
*.p12
*.pfx
*.jks
.env.*
!.env.example
douyin_cookie.txt
*toutiao_cookie.txt
*xhs_cookie.txt

# ===== 日志 =====
/logs/
*.log
*.log.*

# ===== 媒体与下载内容 =====
# 锚定到根目录，否则 `music/` 会连 pages/music/ 一起忽略（历史事故，见文件头说明）
/music/
/videos/
/temp_videos/
*.mp4
*.mp3
*.flv
*.avi
*.mkv
*.mov
*.wav
*.flac

