/* OGC 首页 · 深色主题
   页面容器统一透明，磨砂背景由窗口级 FrostedPanel 透出。
   Hero / 快捷入口卡片 / 公告分段的具体样式在 pages/home_page.py 内联管理，
   保证主题切换时能实时刷新颜色。 */

SettingInterface,
#view {
    background-color: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

/* 快捷入口卡片：半透明玻璃底 + 细边框，文字保持主题前景色 */
FeatureCard {
    background-color: rgba(35, 38, 48, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 14px;
}

FeatureCard:hover {
    background-color: rgba(44, 50, 64, 0.92);
    border: 1px solid rgba(76, 195, 247, 0.35);
}